# Copie para .env.local. Deixe vazio até criar seu projeto Supabase.
# Project Settings > API: Project URL e Publishable key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Nunca coloque uma chave secret ou service_role em NEXT_PUBLIC_*.
# Origem da aplicação para links de e-mail. Desenvolvimento usa localhost:3000.
# Em produção, preencher com a URL HTTPS publicada (sem caminho).
APP_URL=
# Somente servidor: chave AES-256 de 32 bytes em hexadecimal para tokens HTTP.
# Necessária para conexão genérica ou token Bearer. Nunca usar NEXT_PUBLIC_ nesta chave.
CONNECTOR_ENCRYPTION_KEY=
# Somente servidor. Avaliação semântica exige chave e modelo com Structured Outputs.
OPENAI_API_KEY=
OPENAI_EVALUATOR_MODEL=
# Provedor ativo: openai ou gemini. Sem esta variável, preserva OpenAI.
AI_EVALUATOR_PROVIDER=gemini
# Somente servidor: preencher a chave apenas em .env.local, nunca neste exemplo.
GEMINI_API_KEY=
GEMINI_EVALUATOR_MODEL=gemini-3.1-flash-lite
# Preços opcionais em USD por milhão de tokens do modelo configurado.
# Ausentes: custo não calculado. Estimativa sem descontos de cache.
OPENAI_INPUT_USD_PER_MILLION=
OPENAI_OUTPUT_USD_PER_MILLION=
